{
  "fps": 30,
  "totalDurationInFrames": 6499,
  "scenes": [
    {
      "id": 1,
      "startMs": 0,
      "startFrame": 0,
      "durationMs": 5275,
      "durationInFrames": 159,
      "audioFile": null,
      "segments": [
        {
          "text": "深夜零時、消し忘れた画面の光だけが、天井をぼんやりと照らしている。",
          "startFrame": 0,
          "durationInFrames": 149
        }
      ]
    },
    {
      "id": 2,
      "startMs": 5275,
      "startFrame": 158,
      "durationMs": 5215,
      "durationInFrames": 157,
      "audioFile": null,
      "segments": [
        {
          "text": "指が止まる。",
          "startFrame": 0,
          "durationInFrames": 25
        },
        {
          "text": "親友からの結婚の報告が、通知欄に静かに灯っていた。",
          "startFrame": 37,
          "durationInFrames": 110
        }
      ]
    },
    {
      "id": 3,
      "startMs": 10490,
      "startFrame": 315,
      "durationMs": 3976,
      "durationInFrames": 120,
      "audioFile": null,
      "segments": [
        {
          "text": "我々の指は、ためらいなく祝福のスタンプを選び取る。",
          "startFrame": 0,
          "durationInFrames": 110
        }
      ]
    },
    {
      "id": 4,
      "startMs": 14466,
      "startFrame": 434,
      "durationMs": 4297,
      "durationInFrames": 129,
      "audioFile": null,
      "segments": [
        {
          "text": "だが送信した瞬間、胸のどこかが、確かに小さく軋んだ。",
          "startFrame": 0,
          "durationInFrames": 120
        }
      ]
    },
    {
      "id": 5,
      "startMs": 18763,
      "startFrame": 563,
      "durationMs": 5076,
      "durationInFrames": 153,
      "audioFile": null,
      "segments": [
        {
          "text": "祝いたい気持ちに、嘘はない。",
          "startFrame": 0,
          "durationInFrames": 64
        },
        {
          "text": "それだけは断言できるはずだった。",
          "startFrame": 76,
          "durationInFrames": 67
        }
      ]
    },
    {
      "id": 6,
      "startMs": 23839,
      "startFrame": 715,
      "durationMs": 4676,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "会ったこともない有名人の成功では、こんな痛みは走らないのに。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 7,
      "startMs": 28515,
      "startFrame": 855,
      "durationMs": 5536,
      "durationInFrames": 167,
      "audioFile": null,
      "segments": [
        {
          "text": "なぜ、遠い誰かより「親友」の成功こそが、我々を最も深く抉るのか。",
          "startFrame": 0,
          "durationInFrames": 145
        }
      ]
    },
    {
      "id": 8,
      "startMs": 34051,
      "startFrame": 1022,
      "durationMs": 4676,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "1954年、心理学者フェスティンガーは一つの理論を提唱した。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 9,
      "startMs": 38727,
      "startFrame": 1162,
      "durationMs": 5136,
      "durationInFrames": 155,
      "audioFile": null,
      "segments": [
        {
          "text": "人間は自分の価値を、絶対値ではなく、他者との比較でしか測れない。",
          "startFrame": 0,
          "durationInFrames": 145
        }
      ]
    },
    {
      "id": 10,
      "startMs": 43863,
      "startFrame": 1316,
      "durationMs": 5095,
      "durationInFrames": 153,
      "audioFile": null,
      "segments": [
        {
          "text": "「自分は幸せか」という問いは、常に「誰と比べて」を隠し持っている。",
          "startFrame": 0,
          "durationInFrames": 144
        }
      ]
    },
    {
      "id": 11,
      "startMs": 48958,
      "startFrame": 1469,
      "durationMs": 4536,
      "durationInFrames": 137,
      "audioFile": null,
      "segments": [
        {
          "text": "そして我々が物差しに使うのは、決して雲の上の存在ではない。",
          "startFrame": 0,
          "durationInFrames": 127
        }
      ]
    },
    {
      "id": 12,
      "startMs": 53494,
      "startFrame": 1605,
      "durationMs": 3976,
      "durationInFrames": 120,
      "audioFile": null,
      "segments": [
        {
          "text": "同じスタートラインに立っていたはずの、隣の人間だ。",
          "startFrame": 0,
          "durationInFrames": 110
        }
      ]
    },
    {
      "id": 13,
      "startMs": 57470,
      "startFrame": 1724,
      "durationMs": 4996,
      "durationInFrames": 150,
      "audioFile": null,
      "segments": [
        {
          "text": "我々を最も抉るのは、遠い有名人ではなく、手の届く距離の成功だ。",
          "startFrame": 0,
          "durationInFrames": 141
        }
      ]
    },
    {
      "id": 14,
      "startMs": 62466,
      "startFrame": 1874,
      "durationMs": 4816,
      "durationInFrames": 145,
      "audioFile": null,
      "segments": [
        {
          "text": "収入が増えても幸福が続かないのは、比較の基準ごと上がるからだ。",
          "startFrame": 0,
          "durationInFrames": 135
        }
      ]
    },
    {
      "id": 15,
      "startMs": 67282,
      "startFrame": 2018,
      "durationMs": 4676,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "数十万年、我々の祖先はおよそ150人の群れの中で生きてきた。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 16,
      "startMs": 71958,
      "startFrame": 2159,
      "durationMs": 4676,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "その小さな群れの中の序列が、食料と生殖の機会を分配していた。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 17,
      "startMs": 76634,
      "startFrame": 2299,
      "durationMs": 4996,
      "durationInFrames": 150,
      "audioFile": null,
      "segments": [
        {
          "text": "問題は絶対的な豊かさではなく、隣より一段上か、一段下かだった。",
          "startFrame": 0,
          "durationInFrames": 141
        }
      ]
    },
    {
      "id": 18,
      "startMs": 81630,
      "startFrame": 2449,
      "durationMs": 4535,
      "durationInFrames": 137,
      "audioFile": null,
      "segments": [
        {
          "text": "隣の順位を執拗に監視した個体だけが、生き延び子孫を残せた。",
          "startFrame": 0,
          "durationInFrames": 127
        }
      ]
    },
    {
      "id": 19,
      "startMs": 86165,
      "startFrame": 2585,
      "durationMs": 5096,
      "durationInFrames": 153,
      "audioFile": null,
      "segments": [
        {
          "text": "その古い「相対順位センサー」は、現代の脳にもそのまま居座っている。",
          "startFrame": 0,
          "durationInFrames": 144
        }
      ]
    },
    {
      "id": 20,
      "startMs": 91261,
      "startFrame": 2738,
      "durationMs": 5416,
      "durationInFrames": 163,
      "audioFile": null,
      "segments": [
        {
          "text": "ある脳研究では、妬みは痛みの領域を、他人の転落は快の領域を刺激した。",
          "startFrame": 0,
          "durationInFrames": 153
        }
      ]
    },
    {
      "id": 21,
      "startMs": 96677,
      "startFrame": 2900,
      "durationMs": 5535,
      "durationInFrames": 167,
      "audioFile": null,
      "segments": [
        {
          "text": "つまり妬みとは、脳にとって、比喩ではなく物理的な「痛み」なのだ。",
          "startFrame": 0,
          "durationInFrames": 145
        }
      ]
    },
    {
      "id": 22,
      "startMs": 102212,
      "startFrame": 3066,
      "durationMs": 4676,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "ここまでは、我々の内側に組み込まれた古い装置の話にすぎない。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 23,
      "startMs": 106888,
      "startFrame": 3207,
      "durationMs": 5275,
      "durationInFrames": 159,
      "audioFile": null,
      "segments": [
        {
          "text": "本当の問題は、その装置が今、かつてない量の燃料を浴びていることだ。",
          "startFrame": 0,
          "durationInFrames": 149
        }
      ]
    },
    {
      "id": 24,
      "startMs": 112163,
      "startFrame": 3365,
      "durationMs": 4536,
      "durationInFrames": 137,
      "audioFile": null,
      "segments": [
        {
          "text": "サバンナの脳が比較した相手は、せいぜい150人ほどだった。",
          "startFrame": 0,
          "durationInFrames": 127
        }
      ]
    },
    {
      "id": 25,
      "startMs": 116699,
      "startFrame": 3501,
      "durationMs": 4816,
      "durationInFrames": 145,
      "audioFile": null,
      "segments": [
        {
          "text": "だがSNSは、数千人の「人生のハイライト」を毎日供給してくる。",
          "startFrame": 0,
          "durationInFrames": 135
        }
      ]
    },
    {
      "id": 26,
      "startMs": 121515,
      "startFrame": 3645,
      "durationMs": 4675,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "しかも流れてくるのは、加工され選び抜かれた成功の断片だけだ。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 27,
      "startMs": 126190,
      "startFrame": 3786,
      "durationMs": 5095,
      "durationInFrames": 153,
      "audioFile": null,
      "segments": [
        {
          "text": "上ばかりを見る「上方比較」が、常態となった環境を我々は生きている。",
          "startFrame": 0,
          "durationInFrames": 144
        }
      ]
    },
    {
      "id": 28,
      "startMs": 131285,
      "startFrame": 3939,
      "durationMs": 4676,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "そしてプラットフォームは、我々の比較本能を燃やすほど儲かる。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 29,
      "startMs": 135961,
      "startFrame": 4079,
      "durationMs": 5096,
      "durationInFrames": 153,
      "audioFile": null,
      "segments": [
        {
          "text": "心のざわつきは、エンゲージメントという名の収益へと変換されていく。",
          "startFrame": 0,
          "durationInFrames": 144
        }
      ]
    },
    {
      "id": 30,
      "startMs": 141057,
      "startFrame": 4232,
      "durationMs": 4676,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "皮肉にも、親密な相手ほどフィードの上位へ優先して表示される。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 31,
      "startMs": 145733,
      "startFrame": 4372,
      "durationMs": 4856,
      "durationInFrames": 146,
      "audioFile": null,
      "segments": [
        {
          "text": "逃れたい相手が、逃れられない頻度で、繰り返し目の前に現れる。",
          "startFrame": 0,
          "durationInFrames": 137
        }
      ]
    },
    {
      "id": 32,
      "startMs": 150589,
      "startFrame": 4518,
      "durationMs": 4676,
      "durationInFrames": 141,
      "audioFile": null,
      "segments": [
        {
          "text": "我々は自ら、比較から逃げられない檻の中に住みついてしまった。",
          "startFrame": 0,
          "durationInFrames": 131
        }
      ]
    },
    {
      "id": 33,
      "startMs": 155265,
      "startFrame": 4658,
      "durationMs": 5356,
      "durationInFrames": 161,
      "audioFile": null,
      "segments": [
        {
          "text": "ここに悪人はいない。",
          "startFrame": 0,
          "durationInFrames": 42
        },
        {
          "text": "あるのは、ただ精緻に組まれたシステムだけだ。",
          "startFrame": 54,
          "durationInFrames": 98
        }
      ]
    },
    {
      "id": 34,
      "startMs": 160621,
      "startFrame": 4819,
      "durationMs": 6215,
      "durationInFrames": 187,
      "audioFile": null,
      "segments": [
        {
          "text": "親友も、あなたも悪くない。",
          "startFrame": 0,
          "durationInFrames": 60
        },
        {
          "text": "ただ古い脳と、新しすぎる環境があるだけだ。",
          "startFrame": 72,
          "durationInFrames": 94
        }
      ]
    },
    {
      "id": 35,
      "startMs": 166836,
      "startFrame": 5005,
      "durationMs": 4436,
      "durationInFrames": 134,
      "audioFile": null,
      "segments": [
        {
          "text": "そして、これは決して、遠い誰かの心の弱さの話ではない。",
          "startFrame": 0,
          "durationInFrames": 124
        }
      ]
    },
    {
      "id": 36,
      "startMs": 171272,
      "startFrame": 5138,
      "durationMs": 3976,
      "durationInFrames": 120,
      "audioFile": null,
      "segments": [
        {
          "text": "今この画面を見ている、あなた自身の脳の配線の話だ。",
          "startFrame": 0,
          "durationInFrames": 110
        }
      ]
    },
    {
      "id": 37,
      "startMs": 175248,
      "startFrame": 5257,
      "durationMs": 4536,
      "durationInFrames": 137,
      "audioFile": null,
      "segments": [
        {
          "text": "祝福を送った直後、そっと相手のプロフィールを遡って見返す。",
          "startFrame": 0,
          "durationInFrames": 127
        }
      ]
    },
    {
      "id": 38,
      "startMs": 179784,
      "startFrame": 5394,
      "durationMs": 4717,
      "durationInFrames": 142,
      "audioFile": null,
      "segments": [
        {
          "text": "画面の中の充実を、自分の人生の帳尻と、こっそり引き比べる。",
          "startFrame": 0,
          "durationInFrames": 133
        }
      ]
    },
    {
      "id": 39,
      "startMs": 184501,
      "startFrame": 5535,
      "durationMs": 4716,
      "durationInFrames": 142,
      "audioFile": null,
      "segments": [
        {
          "text": "そしてその夜、寝つけぬまま、天井に向かって損得を暗算する。",
          "startFrame": 0,
          "durationInFrames": 132
        }
      ]
    },
    {
      "id": 40,
      "startMs": 189217,
      "startFrame": 5677,
      "durationMs": 4956,
      "durationInFrames": 149,
      "audioFile": null,
      "segments": [
        {
          "text": "だがその痛みは、あなたが誰かを本気で近くに感じている証でもある。",
          "startFrame": 0,
          "durationInFrames": 140
        }
      ]
    },
    {
      "id": 41,
      "startMs": 194173,
      "startFrame": 5825,
      "durationMs": 5615,
      "durationInFrames": 169,
      "audioFile": null,
      "segments": [
        {
          "text": "満たされないのは劣っているからではない。",
          "startFrame": 0,
          "durationInFrames": 84
        },
        {
          "text": "これは、あなたの話だ。",
          "startFrame": 96,
          "durationInFrames": 52
        }
      ]
    },
    {
      "id": 42,
      "startMs": 199788,
      "startFrame": 5994,
      "durationMs": 5216,
      "durationInFrames": 157,
      "audioFile": null,
      "segments": [
        {
          "text": "比較をやめよ、とは言わない。",
          "startFrame": 0,
          "durationInFrames": 64
        },
        {
          "text": "それは臓器を止めろと言うに等しい。",
          "startFrame": 76,
          "durationInFrames": 71
        }
      ]
    },
    {
      "id": 43,
      "startMs": 205004,
      "startFrame": 6150,
      "durationMs": 10772,
      "durationInFrames": 324,
      "audioFile": null,
      "segments": [
        {
          "text": "隣の芝を数えて眠れぬ夜もまた、我々が群れの生き物である証だと、そんなことを、考えすぎてみました。",
          "startFrame": 0,
          "durationInFrames": 218
        },
        {
          "text": "よろしければ、チャンネル登録を。",
          "startFrame": 230,
          "durationInFrames": 73
        }
      ]
    }
  ]
}
