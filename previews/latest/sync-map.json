{
  "fps": 30,
  "totalDurationInFrames": 10651,
  "scenes": [
    {
      "id": 1,
      "startMs": 0,
      "startFrame": 0,
      "durationMs": 8256,
      "durationInFrames": 248,
      "audioFile": "audio/scene-1.mp3",
      "segments": [
        {
          "text": "平日の昼下がり。",
          "startFrame": 0,
          "durationInFrames": 81
        },
        {
          "text": "テレビの中で、コメンテーターが顔を赤らめている。",
          "startFrame": 93,
          "durationInFrames": 143
        }
      ]
    },
    {
      "id": 2,
      "startMs": 8256,
      "startFrame": 248,
      "durationMs": 7320,
      "durationInFrames": 220,
      "audioFile": "audio/scene-2.mp3",
      "segments": [
        {
          "text": "話題は、会ったこともない芸能人の、たった一度の裏切りだ。",
          "startFrame": 0,
          "durationInFrames": 209
        }
      ]
    },
    {
      "id": 3,
      "startMs": 15576,
      "startFrame": 467,
      "durationMs": 9792,
      "durationInFrames": 294,
      "audioFile": "audio/scene-3.mp3",
      "segments": [
        {
          "text": "SNSでは、見知らぬ数万人が、その男を口々に罵倒している。",
          "startFrame": 0,
          "durationInFrames": 283
        }
      ]
    },
    {
      "id": 4,
      "startMs": 25368,
      "startFrame": 761,
      "durationMs": 8520,
      "durationInFrames": 256,
      "audioFile": "audio/scene-4.mp3",
      "segments": [
        {
          "text": "だが冷静に見れば、その不倫で直接傷ついた者は、ここには一人もいない。",
          "startFrame": 0,
          "durationInFrames": 245
        }
      ]
    },
    {
      "id": 5,
      "startMs": 33888,
      "startFrame": 1017,
      "durationMs": 8400,
      "durationInFrames": 252,
      "audioFile": "audio/scene-5.mp3",
      "segments": [
        {
          "text": "それでも我々は、腹の底から突き上げてくる怒りを、抑えることができない。",
          "startFrame": 0,
          "durationInFrames": 241
        }
      ]
    },
    {
      "id": 6,
      "startMs": 42288,
      "startFrame": 1269,
      "durationMs": 9528,
      "durationInFrames": 286,
      "audioFile": "audio/scene-6.mp3",
      "segments": [
        {
          "text": "よく考えてほしい。",
          "startFrame": 0,
          "durationInFrames": 82
        },
        {
          "text": "この怒りは、一体、誰のためのものなのか。",
          "startFrame": 94,
          "durationInFrames": 181
        }
      ]
    },
    {
      "id": 7,
      "startMs": 51816,
      "startFrame": 1554,
      "durationMs": 8184,
      "durationInFrames": 246,
      "audioFile": "audio/scene-7.mp3",
      "segments": [
        {
          "text": "なぜ我々は、無関係な他人の裏切りに、これほどまで怒るのか。",
          "startFrame": 0,
          "durationInFrames": 222
        }
      ]
    },
    {
      "id": 8,
      "startMs": 60000,
      "startFrame": 1800,
      "durationMs": 9048,
      "durationInFrames": 272,
      "audioFile": "audio/scene-8.mp3",
      "segments": [
        {
          "text": "この過剰な怒りの設計図は、数十万年前に、脳の奥へ書き込まれている。",
          "startFrame": 0,
          "durationInFrames": 261
        }
      ]
    },
    {
      "id": 9,
      "startMs": 69048,
      "startFrame": 2071,
      "durationMs": 8832,
      "durationInFrames": 265,
      "audioFile": "audio/scene-9.mp3",
      "segments": [
        {
          "text": "進化の視点では、配偶者とは、奪い合われる希少な資源そのものだ。",
          "startFrame": 0,
          "durationInFrames": 254
        }
      ]
    },
    {
      "id": 10,
      "startMs": 77880,
      "startFrame": 2336,
      "durationMs": 8448,
      "durationInFrames": 254,
      "audioFile": "audio/scene-10.mp3",
      "segments": [
        {
          "text": "ゆえに人間の脳には、裏切りを検知する専用の警報装置が備わった。",
          "startFrame": 0,
          "durationInFrames": 243
        }
      ]
    },
    {
      "id": 11,
      "startMs": 86328,
      "startFrame": 2590,
      "durationMs": 10464,
      "durationInFrames": 314,
      "audioFile": "audio/scene-11.mp3",
      "segments": [
        {
          "text": "心理学者バスは、配偶者への欲求と嫉妬が、文化を超えて普遍的だと示した。",
          "startFrame": 0,
          "durationInFrames": 303
        }
      ]
    },
    {
      "id": 12,
      "startMs": 96792,
      "startFrame": 2904,
      "durationMs": 8640,
      "durationInFrames": 260,
      "audioFile": "audio/scene-12.mp3",
      "segments": [
        {
          "text": "嫉妬は、どの民族にも共通する、極めて古い感情装置なのである。",
          "startFrame": 0,
          "durationInFrames": 249
        }
      ]
    },
    {
      "id": 13,
      "startMs": 105432,
      "startFrame": 3163,
      "durationMs": 8160,
      "durationInFrames": 245,
      "audioFile": "audio/scene-13.mp3",
      "segments": [
        {
          "text": "だが真に謎なのは、当事者ですらない我々が、なお怒るという事実だ。",
          "startFrame": 0,
          "durationInFrames": 234
        }
      ]
    },
    {
      "id": 14,
      "startMs": 113592,
      "startFrame": 3408,
      "durationMs": 5616,
      "durationInFrames": 169,
      "audioFile": "audio/scene-14.mp3",
      "segments": [
        {
          "text": "ここで、最後通牒ゲームという有名な実験を思い出したい。",
          "startFrame": 0,
          "durationInFrames": 158
        }
      ]
    },
    {
      "id": 15,
      "startMs": 119208,
      "startFrame": 3576,
      "durationMs": 8904,
      "durationInFrames": 268,
      "audioFile": "audio/scene-15.mp3",
      "segments": [
        {
          "text": "二人で金を分ける。",
          "startFrame": 0,
          "durationInFrames": 62
        },
        {
          "text": "一方が配分を決め、もう一方は諾否だけを選べる。",
          "startFrame": 74,
          "durationInFrames": 182
        }
      ]
    },
    {
      "id": 16,
      "startMs": 128112,
      "startFrame": 3843,
      "durationMs": 8208,
      "durationInFrames": 247,
      "audioFile": "audio/scene-16.mp3",
      "segments": [
        {
          "text": "取り分が二割を切ると、人は自分が損をしてでも、その提案を拒否する。",
          "startFrame": 0,
          "durationInFrames": 235
        }
      ]
    },
    {
      "id": 17,
      "startMs": 136320,
      "startFrame": 4090,
      "durationMs": 9312,
      "durationInFrames": 280,
      "audioFile": "audio/scene-17.mp3",
      "segments": [
        {
          "text": "経済的には非合理だ。",
          "startFrame": 0,
          "durationInFrames": 90
        },
        {
          "text": "だが人間は、不公平そのものに罰を与えたがる。",
          "startFrame": 102,
          "durationInFrames": 167
        }
      ]
    },
    {
      "id": 18,
      "startMs": 145632,
      "startFrame": 4369,
      "durationMs": 6288,
      "durationInFrames": 189,
      "audioFile": "audio/scene-18.mp3",
      "segments": [
        {
          "text": "フェールらは、この自腹を切ってでも違反者を罰する傾向を研究した。",
          "startFrame": 0,
          "durationInFrames": 178
        }
      ]
    },
    {
      "id": 19,
      "startMs": 151920,
      "startFrame": 4558,
      "durationMs": 7704,
      "durationInFrames": 232,
      "audioFile": "audio/scene-19.mp3",
      "segments": [
        {
          "text": "それは「利他的懲罰」と呼ばれる、人間に組み込まれた本能である。",
          "startFrame": 0,
          "durationInFrames": 221
        }
      ]
    },
    {
      "id": 20,
      "startMs": 159624,
      "startFrame": 4789,
      "durationMs": 8640,
      "durationInFrames": 260,
      "audioFile": "audio/scene-20.mp3",
      "segments": [
        {
          "text": "裏切り者を罰する個体が多い集団ほど、協力が保たれ、生き延びてきた。",
          "startFrame": 0,
          "durationInFrames": 248
        }
      ]
    },
    {
      "id": 21,
      "startMs": 168264,
      "startFrame": 5048,
      "durationMs": 8496,
      "durationInFrames": 255,
      "audioFile": "audio/scene-21.mp3",
      "segments": [
        {
          "text": "つまり我々は、他人を罰したがった者たちの、正当な子孫なのだ。",
          "startFrame": 0,
          "durationInFrames": 232
        }
      ]
    },
    {
      "id": 22,
      "startMs": 176760,
      "startFrame": 5303,
      "durationMs": 8904,
      "durationInFrames": 268,
      "audioFile": "audio/scene-22.mp3",
      "segments": [
        {
          "text": "しかしサバンナ用の掟は、現代という環境で、奇妙に暴走を始める。",
          "startFrame": 0,
          "durationInFrames": 256
        }
      ]
    },
    {
      "id": 23,
      "startMs": 185664,
      "startFrame": 5570,
      "durationMs": 7368,
      "durationInFrames": 222,
      "audioFile": "audio/scene-23.mp3",
      "segments": [
        {
          "text": "かつて我々が罰せた相手は、同じ村に暮らす顔見知りだけだった。",
          "startFrame": 0,
          "durationInFrames": 210
        }
      ]
    },
    {
      "id": 24,
      "startMs": 193032,
      "startFrame": 5791,
      "durationMs": 8664,
      "durationInFrames": 260,
      "audioFile": "audio/scene-24.mp3",
      "segments": [
        {
          "text": "いま我々は、地球の裏側にいる他人さえ、指一本で罰することができる。",
          "startFrame": 0,
          "durationInFrames": 249
        }
      ]
    },
    {
      "id": 25,
      "startMs": 201696,
      "startFrame": 6051,
      "durationMs": 7872,
      "durationInFrames": 237,
      "audioFile": "audio/scene-25.mp3",
      "segments": [
        {
          "text": "社会学者デュルケームは、逸脱者への制裁が集団を結束させると論じた。",
          "startFrame": 0,
          "durationInFrames": 225
        }
      ]
    },
    {
      "id": 26,
      "startMs": 209568,
      "startFrame": 6287,
      "durationMs": 7320,
      "durationInFrames": 220,
      "audioFile": "audio/scene-26.mp3",
      "segments": [
        {
          "text": "悪を叩くその瞬間、我々は自分が「善い側」の一員だと確認できる。",
          "startFrame": 0,
          "durationInFrames": 209
        }
      ]
    },
    {
      "id": 27,
      "startMs": 216888,
      "startFrame": 6507,
      "durationMs": 7416,
      "durationInFrames": 223,
      "audioFile": "audio/scene-27.mp3",
      "segments": [
        {
          "text": "そしてメディアは、この憤りが金に変わることを、熟知している。",
          "startFrame": 0,
          "durationInFrames": 212
        }
      ]
    },
    {
      "id": 28,
      "startMs": 224304,
      "startFrame": 6729,
      "durationMs": 11472,
      "durationInFrames": 345,
      "audioFile": "audio/scene-28.mp3",
      "segments": [
        {
          "text": "怒りは、あらゆる感情の中で最も速く、遠くまで拡散していく。",
          "startFrame": 0,
          "durationInFrames": 333
        }
      ]
    },
    {
      "id": 29,
      "startMs": 235776,
      "startFrame": 7073,
      "durationMs": 8280,
      "durationInFrames": 249,
      "audioFile": "audio/scene-29.mp3",
      "segments": [
        {
          "text": "我々が怒れば怒るほど、画面の向こうの広告は、静かに潤っていく。",
          "startFrame": 0,
          "durationInFrames": 238
        }
      ]
    },
    {
      "id": 30,
      "startMs": 244056,
      "startFrame": 7322,
      "durationMs": 10128,
      "durationInFrames": 304,
      "audioFile": "audio/scene-30.mp3",
      "segments": [
        {
          "text": "正義を執行しているつもりで、我々は自分の注意を、切り売りされている。",
          "startFrame": 0,
          "durationInFrames": 293
        }
      ]
    },
    {
      "id": 31,
      "startMs": 254184,
      "startFrame": 7626,
      "durationMs": 9576,
      "durationInFrames": 288,
      "audioFile": "audio/scene-31.mp3",
      "segments": [
        {
          "text": "悪人はどこにもいない。",
          "startFrame": 0,
          "durationInFrames": 70
        },
        {
          "text": "ただ、古い本能と、新しい装置があるだけだ。",
          "startFrame": 82,
          "durationInFrames": 182
        }
      ]
    },
    {
      "id": 32,
      "startMs": 263760,
      "startFrame": 7913,
      "durationMs": 7968,
      "durationInFrames": 240,
      "audioFile": "audio/scene-32.mp3",
      "segments": [
        {
          "text": "これは、ネットの片隅で吠える、民度の低い誰かの話ではない。",
          "startFrame": 0,
          "durationInFrames": 228
        }
      ]
    },
    {
      "id": 33,
      "startMs": 271728,
      "startFrame": 8152,
      "durationMs": 7704,
      "durationInFrames": 232,
      "audioFile": "audio/scene-33.mp3",
      "segments": [
        {
          "text": "いまこの動画を見ている、あなた自身の脳に刻まれた回路の話である。",
          "startFrame": 0,
          "durationInFrames": 221
        }
      ]
    },
    {
      "id": 34,
      "startMs": 279432,
      "startFrame": 8383,
      "durationMs": 7248,
      "durationInFrames": 218,
      "audioFile": "audio/scene-34.mp3",
      "segments": [
        {
          "text": "不倫の速報が届いた瞬間、指が勝手に記事を開いたことはないか。",
          "startFrame": 0,
          "durationInFrames": 207
        }
      ]
    },
    {
      "id": 35,
      "startMs": 286680,
      "startFrame": 8600,
      "durationMs": 10104,
      "durationInFrames": 304,
      "audioFile": "audio/scene-35.mp3",
      "segments": [
        {
          "text": "他人を裁くその一瞬、あなたの脳の報酬系は、確かに疼いている。",
          "startFrame": 0,
          "durationInFrames": 292
        }
      ]
    },
    {
      "id": 36,
      "startMs": 296784,
      "startFrame": 8904,
      "durationMs": 7872,
      "durationInFrames": 237,
      "audioFile": "audio/scene-36.mp3",
      "segments": [
        {
          "text": "その快感は、恋の高揚を生むのと、ほとんど同じ回路から漏れ出している。",
          "startFrame": 0,
          "durationInFrames": 225
        }
      ]
    },
    {
      "id": 37,
      "startMs": 304656,
      "startFrame": 9140,
      "durationMs": 8784,
      "durationInFrames": 264,
      "audioFile": "audio/scene-37.mp3",
      "segments": [
        {
          "text": "「許せない」という言葉の裏側で、我々は微かに、それを愉しんでいる。",
          "startFrame": 0,
          "durationInFrames": 253
        }
      ]
    },
    {
      "id": 38,
      "startMs": 313440,
      "startFrame": 9403,
      "durationMs": 6600,
      "durationInFrames": 198,
      "audioFile": "audio/scene-38.mp3",
      "segments": [
        {
          "text": "正義とは、最も後ろめたさのない、娯楽の仮面なのかもしれない。",
          "startFrame": 0,
          "durationInFrames": 187
        }
      ]
    },
    {
      "id": 39,
      "startMs": 320040,
      "startFrame": 9601,
      "durationMs": 8904,
      "durationInFrames": 268,
      "audioFile": "audio/scene-39.mp3",
      "segments": [
        {
          "text": "鏡を見よ。",
          "startFrame": 0,
          "durationInFrames": 73
        },
        {
          "text": "怒りに歪んだその顔は、獲物を見つけた狩人の顔だ。",
          "startFrame": 85,
          "durationInFrames": 159
        }
      ]
    },
    {
      "id": 40,
      "startMs": 328944,
      "startFrame": 9868,
      "durationMs": 8400,
      "durationInFrames": 252,
      "audioFile": "audio/scene-40.mp3",
      "segments": [
        {
          "text": "我々は今日も、誰かの罪を薪にして、束の間の暖をとって生きている。",
          "startFrame": 0,
          "durationInFrames": 241
        }
      ]
    },
    {
      "id": 41,
      "startMs": 337344,
      "startFrame": 10120,
      "durationMs": 16992,
      "durationInFrames": 510,
      "audioFile": "audio/scene-41.mp3",
      "segments": [
        {
          "text": "人間とは、正義の顔をして他人を狩る、考える葦である。",
          "startFrame": 0,
          "durationInFrames": 221
        },
        {
          "text": "そんなことを、考えすぎてみました。",
          "startFrame": 233,
          "durationInFrames": 132
        },
        {
          "text": "よろしければ、チャンネル登録を。",
          "startFrame": 377,
          "durationInFrames": 110
        }
      ]
    }
  ]
}
