      "concept_color": "charcoal"
    },
    {
      "id": 26,
      "act": 3,
      "narration": "悪を叩くその瞬間、我々は自分が「善い側」の一員だと確認できる。",
      "visual": {
        "type": "figure",
        "figure": "applause",
        "label": "善い側の確認"
      },
      "concept_color": "charcoal"
    },
    {
      "id": 27,
