        "type": "chart",
        "title": "感情別の拡散されやすさ",
        "unit": "拡散度",
        "items": [
          {
            "label": "喜び",
            "value": 40
          },
          {
            "label": "悲しみ",
            "value": 30
          },
          {
            "label": "怒り",
            "value": 90
          }
        ]
