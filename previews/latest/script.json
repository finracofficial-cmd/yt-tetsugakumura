{
  "theme": "最も近しい親友の成功に、祝福と同時に胸がざわつくという普遍的な感情のタブーを、進化した脳と現代環境のミスマッチとして解剖する。",
  "title": "なぜ親友の成功はこんなにも胸をざわつかせるのか【進化心理学×社会比較理論】",
  "bgm_direction": "Dark minimal ambient underscore with slow evolving synth pads and sparse melancholic felt piano. Quiet, contemplative, with a faint undercurrent of unease.",
  "scenes": [
    {
      "id": 1,
      "act": 1,
      "narration": "深夜0時。スマートフォンの光だけが、暗い部屋で我々の顔を照らしている。",
      "visual": {
        "type": "dialogue",
        "line": "おめでとう、と指が打った"
      },
      "concept_color": "dark-navy"
    },
    {
      "id": 2,
      "act": 1,
      "narration": "画面には、最も古い親友からのメッセージ。「結婚することになった」と。",
      "visual": {
        "type": "figure",
        "figure": "smartphone",
        "label": "親友からの報告"
      },
      "concept_color": "dark-navy"
    },
    {
      "id": 3,
      "act": 1,
      "narration": "我々は反射的に、祝福の言葉を打ち込む。指は、正しく動いている。",
      "visual": {
        "type": "figure",
        "figure": "heart",
        "label": "祝福の言葉"
      },
      "concept_color": "dark-navy"
    },
    {
      "id": 4,
      "act": 1,
      "narration": "だが送信した直後、みぞおちの奥で、小さな何かがざわつくのだ。",
      "visual": {
        "type": "dialogue",
        "line": "なぜ、少し胸が苦しい"
      },
      "concept_color": "dark-navy"
    },
    {
      "id": 5,
      "act": 1,
      "narration": "それは確かに祝福だった。だが同時に、名前のつかない痛みでもあった。",
      "visual": {
        "type": "figure",
        "figure": "anxiety",
        "label": "名のない痛み"
      },
      "concept_color": "dark-navy"
    },
    {
      "id": 6,
      "act": 1,
      "narration": "世間は言う。親友の幸福は、我が事のように嬉しいはずだ、と。",
      "visual": {
        "type": "figure",
        "figure": "couple",
        "label": "世間の常識"
      },
      "concept_color": "dark-navy"
    },
    {
      "id": 7,
      "act": 1,
      "narration": "だが、本当にそうだろうか。今一度、自分の胸に手を当ててほしい。",
      "visual": {
        "type": "figure",
        "figure": "person",
        "label": "胸に手を当てる"
      },
      "concept_color": "dark-navy"
    },
    {
      "id": 8,
      "act": 1,
      "narration": "なぜ、最も近しい者の成功ほど、我々の胸を鋭く抉るのか。",
      "visual": {
        "type": "figure",
        "figure": "question",
        "label": "なぜ近い者ほどざわつくのか"
      },
      "concept_color": "dark-navy"
    },
    {
      "id": 9,
      "act": 2,
      "narration": "この不可解な痛みを、二つの学問が、感情を排して解剖していく。",
      "visual": {
        "type": "figure",
        "figure": "thought",
        "label": "解剖のはじまり"
      },
      "concept_color": "charcoal"
    },
    {
      "id": 10,
      "act": 2,
      "narration": "かつて心理学者フェスティンガーは、人間のある性質を指摘した。",
      "visual": {
        "type": "stat",
        "value": "1954年",
        "label": "フェスティンガー 社会的比較理論"
      },
      "concept_color": "charcoal"
    },
    {
      "id": 11,
      "act": 2,
      "narration": "我々は自分の価値を、絶対的な物差しでは測れない生き物だ、と。",
      "visual": {
        "type": "figure",
        "figure": "scale",
        "label": "絶対では測れない"
      },
      "concept_color": "charcoal"
    },
    {
      "id": 12,
      "act": 2,
      "narration": "自分が優れているかは、常に「誰かとの差」でしか確認できないのだ。",
      "visual": {
        "type": "comparison",
        "left_title": "絶対評価",
        "right_title": "相対評価",
        "left_items": [
          "自分で完結",
          "揺るがない"
