      "concept_color": "charcoal"
    },
    {
      "id": 20,
      "act": 2,
      "narration": "その小さな群れの中での順位が、生存と繁殖を直接左右したのだ。",
      "visual": {
        "type": "figure",
        "figure": "podium",
        "label": "順位が命を分けた"
