      "durationInFrames": 203,
      "audioFile": null,
      "segments": [
        {
          "text": "人間の集中力には限界がある。",
          "startFrame": 0,
          "durationInFrames": 59
        },
        {
          "text": "認知資源は有限であり、反復作業はそれを静かに削り取っていく。",
          "startFrame": 68,
          "durationInFrames": 131
        }
      ]
    },
