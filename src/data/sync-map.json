      "startFrame": 506,
      "durationMs": 5226,
      "durationInFrames": 157,
      "audioFile": null,
      "segments": [
        {
          "text": "出生率は1.04から0.99へ、そして0.96へと細り続けている。",
          "startFrame": 0,
          "durationInFrames": 143
        }
      ]
    },
    {
