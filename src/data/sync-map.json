      "startFrame": 815,
      "durationMs": 6685,
      "durationInFrames": 201,
      "audioFile": null,
      "segments": [
        {
          "text": "人間と機械では、得意なことがまるで違う。",
          "startFrame": 0,
          "durationInFrames": 89
        },
        {
          "text": "判断と創造は人間に、反復と精密は機械に。",
